APP_NAME=Notifika
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=notifika
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.xxxxxxxxxxxxxxx
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ted.co.mz
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Notifika
NOTIFIKA_MAX_ATTEMPTS=3
NOTIFIKA_QUEUE=notifications

# Slug do cliente por omissão de uma instalação self-hosted (CA-16). É a
# este cliente que ficam ligados os tokens sem cliente próprio.
NOTIFIKA_DEFAULT_CLIENT_SLUG=default

# Canal SMS — credenciais da instalação (usadas quando o cliente não tem
# credenciais próprias no painel). Deixar NOTIFIKA_SMS_DRIVER vazio
# desactiva o SMS a nível da instalação (a API devolve 422 "canal não
# configurado" até haver credenciais de cliente ou de instalação).
NOTIFIKA_SMS_DRIVER=
# NOTIFIKA_SMS_DRIVER=twilio
# NOTIFIKA_SMS_DRIVER=log

# Sender ID alfanumérico (ex.: NOTIFIKA). A Movitel não entrega SMS vindos
# de um número internacional simples — registar o sender ID na Twilio
# (leva cerca de uma semana). Ver docs/sdd/canais-sms-whatsapp.md §2.
NOTIFIKA_SMS_SENDER=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
