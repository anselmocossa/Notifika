<?xml version="1.0" encoding="UTF-8"?>
<!--
    Corre a mesma suite contra PostgreSQL, na base de testes isolada
    "notifika_test" (nunca a "notifika" de desenvolvimento). Este ficheiro
    não muda a omissão SQLite do phpunit.xml — é uma configuração à parte,
    para apanhar em CI/local os defeitos que só aparecem com um SGBD que
    impõe tipos a sério (ver a migração
    2026_09_10_100005_convert_personal_access_tokens_tokenable_id_to_string).

    Preparação (uma vez, no mesmo servidor local do DB_CONNECTION=pgsql do
    .env, 127.0.0.1:5432, utilizador sem password):
        createdb -h 127.0.0.1 -U anselmokossa notifika_test

    Uso:
        php artisan test -c phpunit.pgsql.xml
        vendor/bin/phpunit -c phpunit.pgsql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="notifika_test"/>
        <env name="DB_USERNAME" value="anselmokossa"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
